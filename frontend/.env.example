# Frontend API path. Keep this as /api so local development matches production.
NUXT_PUBLIC_API_BASE=/api

# Rust backend origin used by Nuxt route rules when /api is handled by Nuxt.
NUXT_API_PROXY_TARGET=http://127.0.0.1:7878

# legacy: existing contacts; v2: symmetric friends and requests; mock: local development only.
NUXT_PUBLIC_SOCIAL_MODE=v2

# Social capabilities. All of these are implemented by backend 0.6.0; set a
# flag to false to keep that UI hidden.
NUXT_PUBLIC_SOCIAL_BLOCKS_ENABLED=true
NUXT_PUBLIC_SOCIAL_PREFERENCES_ENABLED=true
NUXT_PUBLIC_SOCIAL_PRESENCE_ENABLED=true
NUXT_PUBLIC_SOCIAL_HISTORY_ENABLED=true
NUXT_PUBLIC_SOCIAL_DIRECTORY_ENABLED=true
NUXT_PUBLIC_SOCIAL_PROFILES_ENABLED=true
NUXT_PUBLIC_SOCIAL_METADATA_ENABLED=true
NUXT_PUBLIC_SOCIAL_GROUPS_ENABLED=true
NUXT_PUBLIC_SOCIAL_CONVERSATIONS_ENABLED=true
NUXT_PUBLIC_SOCIAL_RECEIPTS_ENABLED=true

# Development mock fixture: standard | large (57 friends and a long name).
NUXT_PUBLIC_SOCIAL_DEMO_SCENARIO=standard

# disabled | v2 | mock (development only)
NUXT_PUBLIC_ACCOUNT_RECOVERY_MODE=v2
