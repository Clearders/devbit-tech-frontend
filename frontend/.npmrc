# ── pnpm 安装速度优化 ──────────────────────────────────────────────

# 依赖解析模式：只解析顶层依赖的版本范围，忽略传递依赖的多个候选版本
# 可将解析时间缩短 30-50%，适用于大多数项目
resolution-mode=lowest-direct

# 网络并发数：增加同时下载的包数量 (默认 16，推荐 32-64)
network-concurrency=32

# 子进程并发数：增加并行执行的子进程 (默认 5)
child-concurrency=5

# 跳过全局 store 完整性校验 (开发环境安全，CI 中建议保留)
verify-store-integrity=false

# 跳过 peer dependency 检查，避免因 peer 冲突而中断安装
strict-peer-dependencies=false

# 启用副作用缓存：跳过重复的包副作用检测 (pnpm v8.6+)
side-effects-cache=true

# ── 如果在中国大陆，取消下面这行注释可获得显著加速 ─────────────────
# registry=https://registry.npmmirror.com
